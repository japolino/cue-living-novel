{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun-types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/runtime/inlay-adapter.ts",
    "src/runtime/inlay-adapter.test.ts",
    "src/inlay-image-pipeline/**/*.ts",
    "src/config.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}